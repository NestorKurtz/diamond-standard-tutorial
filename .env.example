# Mnemonic (alternative to private key)
MNEMONIC=test test test test test test test test test test test junk

# Network Configuration
NETWORK=localhost
CHAIN_ID=31337

# Gas Settings
GAS_PRICE=
GAS_LIMIT=

# IPFS
